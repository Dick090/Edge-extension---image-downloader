{
  "manifest_version": 3,
  "name": "Image Collector",
  "version": "2.0",
  "description": "Automatically collect images from websites as you scroll.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Image Collector"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
